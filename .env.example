# Copy to .env and fill from 1Password. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173

# --- Supabase ---
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
# Postgres connection string, Settings -> Database -> Connection string (URI).
# Embeds the database password set at project creation.
DATABASE_URL=

# Project ref and region, from Supabase -> Connect. Used by scripts/set-db-password.mjs.
SUPABASE_PROJECT_REF=
SUPABASE_REGION=us-west-2

SUPABASE_URL=
# Service role key. Server-side only — this bypasses RLS, so it must never
# reach the browser bundle. See docs/security.md.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket holding uploaded carrier quotes (private).
SUPABASE_UPLOADS_BUCKET=sp-uploads
# Storage bucket holding generated proposal PDFs (private).
SUPABASE_DOCUMENTS_BUCKET=sp-documents

# --- Sessions ---
# 32+ random bytes, base64. Generate: openssl rand -base64 48
SESSION_SECRET=
# Session lifetime in hours.
SESSION_TTL_HOURS=12

# --- Extraction provider ---
# One of: anthropic | fake
# "fake" replays committed fixtures and makes no network calls. It exists so the
# review screen can be built and demoed before an API key is available.
EXTRACTION_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Copy to .env for local development. Never commit either.
#
# Two files, on purpose.
#
#   .env              local development. Holds no credentials, and every value
#                     that would reach a real service is left unset so the app
#                     falls back to a database, a file store and an extractor
#                     that live on this machine.
#
#   .env.production   the real credentials, from 1Password. Passed EXPLICITLY and
#                     never loaded by accident:
#                         npm run db:status:prod
#                         node --env-file=.env.production scripts/migrate.mjs
#
# The deployed app reads neither; the host holds its own copy of these names.
#
# The split exists because they used to be one file. Development ran against the
# live database, so `npm run dev` wrote to the system brokers use — test
# proposals appeared in the real list, and a mistaken script would have hit real
# client data.

# --- App ---
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000

# --- Database ---
# Leave UNSET locally: the API uses PGlite under apps/api/.pglite and applies
# migrations itself at boot. Setting it points development at a real database.
# In .env.production: Supabase -> Settings -> Database -> Connection string (URI).
DATABASE_URL=

# Project ref and region, from Supabase -> Connect. Used by scripts/set-db-password.mjs.
SUPABASE_PROJECT_REF=
SUPABASE_REGION=us-west-2

# --- Storage ---
# Leave UNSET locally: uploads and generated PDFs go to ./.storage.
SUPABASE_URL=
# Service role key. Server-side only — this bypasses RLS, so it must never
# reach the browser bundle. See docs/security.md.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_UPLOADS_BUCKET=sp-uploads
SUPABASE_DOCUMENTS_BUCKET=sp-documents

# --- Sessions ---
# 32+ random bytes, base64. Generate: openssl rand -base64 48
# Locally this protects nothing but a session on your own machine; production's
# must be a different, real value.
SESSION_SECRET=
SESSION_TTL_HOURS=12

# --- Extraction provider ---
# One of: anthropic | fake
# "fake" replays committed fixtures and makes no network call, so development
# costs nothing and works with the API account at zero.
EXTRACTION_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Cost reporting (optional) ---
# Price per million tokens, from your own Anthropic invoice. Leave unset and the
# app reports token counts without money — better than showing a figure derived
# from a rate nobody checked.
ANTHROPIC_INPUT_COST_PER_MTOK=
ANTHROPIC_OUTPUT_COST_PER_MTOK=

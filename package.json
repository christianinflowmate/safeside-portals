{
  "name": "safeside-proposals",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/api & npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "typecheck": "tsc --noEmit",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "user:create": "node --env-file-if-exists=.env scripts/create-user.mjs",
    "db:check": "node --env-file-if-exists=.env scripts/check-migrations.mjs",
    "db:migrate:prod": "node --env-file=.env.production scripts/migrate.mjs",
    "db:status:prod": "node --env-file=.env.production scripts/migrate.mjs --status",
    "user:create:prod": "node --env-file=.env.production scripts/create-user.mjs",
    "user:password:prod": "node --env-file=.env.production scripts/set-password.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@supabase/supabase-js": "^2.116.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
